{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheReleaseBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::4dstem-explorer"
    },
    {
      "Sid": "PublishReleases",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:PutObjectAcl"],
      "Resource": "arn:aws:s3:::4dstem-explorer/*"
    }
  ]
}
